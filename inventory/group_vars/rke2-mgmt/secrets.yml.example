# Example secret overrides for the rke2-mgmt cluster bootstrap.
#
# Copy this file to `secrets.yml` (same directory) and fill in real values.
# `secrets.yml` is gitignored. Ansible auto-merges every *.yml in
# inventory/group_vars/rke2-mgmt/ for plays targeting the rke2-mgmt group,
# and the bootstrap playbooks vars_files this file in explicitly (they
# target localhost, which isn't in any inventory group).
#
# Anything in here overrides the same key in main.yml. Keep this file
# small — only put values you wouldn't want in git.

# Rancher's initial bootstrap password (used at first login through the UI).
# Replace with something strong; rotate from inside Rancher after first login.
rancher_bootstrap_password: "REPLACE-ME-with-a-strong-bootstrap-password"
